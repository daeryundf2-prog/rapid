{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linux login accounting record",
  "type": "object",
  "required": ["log_kind", "layout", "user", "tty", "host", "id", "address", "exit_termination", "exit_status", "uid", "pid", "type", "type_name", "session", "timestamp", "timestamp_sec", "timestamp_usec", "source_path", "source_offset", "source_length", "record_sha256"],
  "properties": {
    "log_kind": { "enum": ["utmp", "wtmp", "btmp", "lastlog"] },
    "layout": { "type": "string" },
    "user": { "type": "string" },
    "account_lookup": { "enum": ["complete", "truncated", "unavailable"], "description": "Lastlog only: whether the UID-to-name lookup read the whole passwd file. `user` is empty unless it is complete." },
    "tty": { "type": "string" },
    "host": { "type": "string" },
    "id": { "type": "string" },
    "address": { "type": "string" },
    "exit_termination": { "type": ["integer", "null"] },
    "exit_status": { "type": ["integer", "null"] },
    "uid": { "type": ["integer", "null"], "minimum": 0 },
    "pid": { "type": ["integer", "null"] },
    "type": { "type": ["integer", "null"] },
    "type_name": { "type": "string" },
    "session": { "type": ["integer", "null"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "timestamp_sec": { "type": "integer" },
    "timestamp_usec": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999 },
    "source_path": { "type": "string" },
    "source_offset": { "type": "integer", "minimum": 0 },
    "source_length": { "enum": [292, 384] },
    "record_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
