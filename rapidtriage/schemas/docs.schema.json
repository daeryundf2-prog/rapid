{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "root",
    "generated_at",
    "summary",
    "manifest",
    "candidates",
    "results"
  ],
  "properties": {
    "command": {
      "const": "docs"
    },
    "root": {
      "type": "string"
    },
    "scan_scope_root": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "match_count",
        "supported_extensions"
      ],
      "properties": {
        "candidate_count": {
          "type": "integer"
        },
        "match_count": {
          "type": "integer"
        },
        "supported_extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_rule_count": {
          "type": "integer"
        },
        "ioc_hit_count": {
          "type": "integer"
        },
        "extraction_error_count": {
          "type": "integer"
        },
        "skipped_document_count": {
          "type": "integer"
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "path",
        "strategy",
        "version",
        "document_count",
        "term_count"
      ],
      "properties": {
        "command": {
          "const": "docs-index"
        },
        "path": {
          "type": "string"
        },
        "strategy": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "document_count": {
          "type": "integer"
        },
        "term_count": {
          "type": "integer"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "root",
        "platform",
        "keywords",
        "providers"
      ],
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "root": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "target_platform",
              "supported",
              "artifacts"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "target_platform": {
                "type": "string"
              },
              "supported": {
                "type": "boolean"
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider",
                    "artifact_type",
                    "path",
                    "supported",
                    "details"
                  ],
                  "properties": {
                    "provider": {
                      "type": "string"
                    },
                    "artifact_type": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "supported": {
                      "type": "boolean"
                    },
                    "details": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "size",
          "modified_at"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "modified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "matched_keywords",
          "preview",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "matched_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preview": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "matched_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ioc_hits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule_id",
                "type",
                "value"
              ],
              "properties": {
                "rule_id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "extraction_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "size",
          "reason",
          "error_type",
          "message",
          "recoverable",
          "effect"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "error_type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "effect": {
            "type": "string"
          }
        }
      }
    },
    "rule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "rule_count"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "rule_count": {
          "type": "integer"
        }
      }
    },
    "matched_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ioc_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "type",
          "value"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    }
  }
}
