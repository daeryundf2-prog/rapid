{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "kind",
    "generated_at",
    "root",
    "provider",
    "summary",
    "artifacts"
  ],
  "properties": {
    "command": {
      "const": "artifacts"
    },
    "kind": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "root": {
      "type": "string"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "target_platform",
        "supported"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "target_platform": {
          "type": "string"
        },
        "supported": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_count",
        "artifact_type_counts"
      ],
      "properties": {
        "artifact_count": {
          "type": "integer"
        },
        "artifact_type_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "parser_error_count": {
          "type": "integer"
        },
        "collection_status": {
          "type": "string"
        },
        "matched_rule_count": {
          "type": "integer"
        },
        "ioc_hit_count": {
          "type": "integer"
        },
        "artifact_record_contract_valid_count": {
          "type": "integer"
        },
        "artifact_record_contract_invalid_count": {
          "type": "integer"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "artifact_type",
          "path",
          "supported",
          "details"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "supported": {
            "type": "boolean"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "artifact_record": {
            "type": "object",
            "additionalProperties": true
          },
          "matched_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ioc_hits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule_id",
                "type",
                "value"
              ],
              "properties": {
                "rule_id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "artifact_record_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version",
        "schema",
        "adapter_version",
        "record_count",
        "valid_count",
        "invalid_count",
        "gui_usable",
        "errors"
      ],
      "properties": {
        "profile_version": {
          "const": "artifact-output-contract-v1"
        },
        "schema": {
          "const": "ArtifactRecordV1"
        },
        "adapter_version": {
          "type": "string"
        },
        "record_count": {
          "type": "integer"
        },
        "valid_count": {
          "type": "integer"
        },
        "invalid_count": {
          "type": "integer"
        },
        "gui_usable": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "parser_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "collector",
          "error_type",
          "message"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "collector": {
            "type": "string"
          },
          "error_type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "rule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "rule_count"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "rule_count": {
          "type": "integer"
        }
      }
    },
    "matched_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ioc_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "type",
          "value"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    }
  }
}
