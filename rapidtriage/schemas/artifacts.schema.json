{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "kind", "generated_at", "root", "provider", "summary", "artifacts"],
  "properties": {
    "command": { "const": "artifacts" },
    "kind": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "root": { "type": "string" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "target_platform", "supported"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "target_platform": { "type": "string" },
        "supported": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_count", "artifact_type_counts"],
      "properties": {
        "artifact_count": { "type": "integer" },
        "artifact_type_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "artifact_type", "path", "supported", "details"],
        "properties": {
          "provider": { "type": "string" },
          "artifact_type": { "type": "string" },
          "path": { "type": "string" },
          "supported": { "type": "boolean" },
          "details": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}
