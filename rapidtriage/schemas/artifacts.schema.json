{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "kind",
    "generated_at",
    "root",
    "provider",
    "summary",
    "artifacts"
  ],
  "properties": {
    "command": {
      "const": "artifacts"
    },
    "kind": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "root": {
      "type": "string"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "target_platform",
        "supported"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "target_platform": {
          "type": "string"
        },
        "supported": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_count",
        "artifact_type_counts"
      ],
      "properties": {
        "artifact_count": {
          "type": "integer"
        },
        "artifact_type_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "parser_error_count": {
          "type": "integer"
        },
        "collection_status": {
          "type": "string"
        },
        "matched_rule_count": {
          "type": "integer"
        },
        "ioc_hit_count": {
          "type": "integer"
        },
        "artifact_record_contract_valid_count": {
          "type": "integer"
        },
        "artifact_record_contract_invalid_count": {
          "type": "integer"
        },
        "collection_notes": {
          "type": "array"
        },
        "skipped_row_count": {
          "type": "integer"
        },
        "skip_reasons": {
          "type": "object"
        },
        "export_roots": {
          "type": "array"
        },
        "acquisition_roots": {
          "type": "array"
        },
        "channel_counts": {
          "type": "object",
          "description": "EventLog kind: rows per raw channel name (core/eventlog_channels.py)",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "channel_service_control_manager_count": {
          "type": "integer"
        },
        "channel_overflow_group_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "artifact_type",
          "path",
          "supported",
          "details"
        ],
        "allOf": [
          {
            "if": {
              "properties": { "artifact_type": { "const": "macos-knowledgec-event" } },
              "not": { "required": ["profile_ref"] }
            },
            "then": {
              "properties": {
                "details": {
                  "required": ["source_row_id", "stream", "unknown_stream", "start_raw", "end_raw", "timestamp", "start_at", "end_at", "structured_metadata"],
                  "properties": {
                    "stream": { "type": "string" },
                    "unknown_stream": { "type": "boolean" },
                    "timestamp": { "type": ["string", "null"] },
                    "start_at": { "type": ["string", "null"] },
                    "end_at": { "type": ["string", "null"] },
                    "structured_metadata": { "type": "object" }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "artifact_type": { "const": "macos-unified-log-event" } },
              "not": { "required": ["profile_ref"] }
            },
            "then": {
              "properties": {
                "details": {
                  "required": ["source_path", "source_offset", "continuous_time", "event_type", "process", "subsystem", "category", "message"],
                  "properties": {
                    "source_path": { "type": "string" },
                    "source_offset": { "type": "integer", "minimum": 0 },
                    "continuous_time": { "type": "integer", "minimum": 0 },
                    "timestamp": { "type": ["string", "null"], "format": "date-time" },
                    "event_type": { "enum": ["log", "activity", "signpost", "trace"] },
                    "process": { "type": "string" },
                    "subsystem": { "type": "string" },
                    "category": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "artifact_type": { "const": "linux-journald-entry" } },
              "not": { "required": ["profile_ref"] }
            },
            "then": {
              "properties": {
                "details": {
                  "required": ["source_offset", "length", "entry_array_offset", "data_offsets", "timestamp", "realtime_raw", "monotonic_raw", "fields", "journal_state", "compact", "keyed_hash", "limitations"],
                  "properties": {
                    "source_offset": { "type": "integer", "minimum": 0 },
                    "length": { "type": "integer", "minimum": 0 },
                    "entry_array_offset": { "type": "integer", "minimum": 0 },
                    "data_offsets": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
                    "timestamp": { "type": ["string", "null"] },
                    "realtime_raw": { "type": "integer", "minimum": 0 },
                    "monotonic_raw": { "type": "integer", "minimum": 0 },
                    "fields": { "type": "object" },
                    "journal_state": { "enum": ["offline", "online", "archived"] },
                    "compact": { "type": "boolean" },
                    "keyed_hash": { "type": "boolean" },
                    "limitations": { "type": "array" }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "artifact_type": { "const": "macos-unified-log-diagnostic" } },
              "not": { "required": ["profile_ref"] }
            },
            "then": {
              "properties": {
                "details": {
                  "required": ["source_path", "source_offset", "reason"],
                  "properties": {
                    "source_path": { "type": "string" },
                    "source_offset": { "type": "integer", "minimum": 0 },
                    "reason": { "type": "string" },
                    "format_reference": { "type": "string" }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "artifact_type": { "enum": ["macos-knowledgec-diagnostic", "linux-journald-diagnostic"] } },
              "not": { "required": ["profile_ref"] }
            },
            "then": {
              "properties": {
                "details": {
                  "required": ["source_path", "reason"],
                  "properties": { "source_path": { "type": "string" }, "reason": { "type": "string" } }
                }
              }
            }
          }
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "supported": {
            "type": "boolean"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "artifact_record": {
            "type": "object",
            "additionalProperties": true,
            "description": "ArtifactRecordV1 envelope; run outputs omit fields (fields_source: details) and hoist constant envelope parts into artifact_type_profiles"
          },
          "matched_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ioc_hits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule_id",
                "type",
                "value"
              ],
              "properties": {
                "rule_id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          },
          "profile_ref": {
            "type": "string",
            "description": "artifact_type whose artifact_type_profiles entry holds this row's hoisted constant blocks; merge it back with expand_profile"
          },
          "incremental_reuse": {
            "type": "object",
            "additionalProperties": true
          },
          "context_ref": {
            "type": "boolean",
            "description": "true when artifact_type_profiles[profile_ref].contexts[path] holds this row's per-source-file constants"
          }
        },
        "if": {
          "properties": {
            "provider": {
              "enum": [
                "claude-code",
                "codex-cli",
                "gemini-cli",
                "editor-chat",
                "agent-mcp",
                "herdr-sessions"
              ]
            }
          },
          "not": {
            "required": [
              "profile_ref"
            ]
          }
        },
        "then": {
          "properties": {
            "details": {
              "$ref": "#/$defs/agentDetails"
            }
          }
        }
      }
    },
    "artifact_record_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version",
        "schema",
        "adapter_version",
        "record_count",
        "valid_count",
        "invalid_count",
        "gui_usable",
        "errors"
      ],
      "properties": {
        "profile_version": {
          "const": "artifact-output-contract-v1"
        },
        "schema": {
          "const": "ArtifactRecordV1"
        },
        "adapter_version": {
          "type": "string"
        },
        "artifact_id_scheme": {
          "type": "string"
        },
        "record_count": {
          "type": "integer"
        },
        "valid_count": {
          "type": "integer"
        },
        "invalid_count": {
          "type": "integer"
        },
        "gui_usable": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "parser_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "collector",
          "error_type",
          "message"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "collector": {
            "type": "string"
          },
          "error_type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated_row_errors": {
            "type": "integer"
          }
        }
      }
    },
    "rule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "rule_count"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "rule_count": {
          "type": "integer"
        }
      }
    },
    "matched_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ioc_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "type",
          "value"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    },
    "artifact_type_profiles": {
      "type": "object",
      "description": "Per artifact_type templates of constant (parts of) details blocks and the ArtifactRecordV1 envelope; rows with profile_ref deep-merge their residue over them",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "artifact_record": {
            "type": "object",
            "additionalProperties": true
          },
          "contexts": {
            "type": "object",
            "description": "per source file (row path) templates: details/artifact_record",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "codes": {
            "type": "object",
            "description": "dictionary-encoded details labels: key -> value list; rows hold the index",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "collector_options": {
      "type": "object",
      "additionalProperties": true
    },
    "artifacts_preview": {
      "type": "boolean",
      "description": "true when artifacts holds only the first rows; the full row stream is records_path"
    },
    "record_count": {
      "type": "integer",
      "description": "rows in records_path"
    },
    "records_path": {
      "type": "string",
      "description": "absolute path of the JSONL row stream (one artifacts row per line)"
    },
    "records_file": {
      "type": "string",
      "description": "records_path file name, resolved next to this JSON when the run directory moved"
    },
    "records_format": {
      "const": "jsonl"
    },
    "incremental_delta": {
      "type": "object",
      "additionalProperties": true
    },
    "stage_reuse": {
      "type": "object",
      "description": "Run stage reuse binding a --resume run must match: evidence identity digest, input fingerprint, stage options digest",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "agentDetails": {
      "description": "Expanded AI coding-agent details. Streamed rows may hoist shared fields into profiles.",
      "type": "object",
      "required": [
        "source_path",
        "agent",
        "role",
        "text",
        "model",
        "session_id",
        "cwd",
        "tool_name",
        "command_line",
        "schema_version",
        "file_paths",
        "flags",
        "timestamp_raw",
        "timestamp_utc"
      ],
      "properties": {
        "source_path": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "command_line": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "file_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timestamp_raw": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "timestamp_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_line": {
          "type": "integer",
          "minimum": 0
        },
        "source_offset": {
          "type": "integer",
          "minimum": 0
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "content_index": {
          "type": "integer",
          "minimum": 0
        },
        "tool_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_table": {
          "type": "string"
        },
        "source_rowid": {
          "type": "integer"
        },
        "env_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
