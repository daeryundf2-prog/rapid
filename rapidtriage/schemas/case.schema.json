{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "generated_at",
    "updated_at",
    "case_id",
    "title",
    "summary",
    "bookmarks"
  ],
  "properties": {
    "command": {
      "const": "case"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "case_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bookmark_count",
        "tagged_bookmark_count",
        "tag_counts",
        "source_command_counts"
      ],
      "properties": {
        "bookmark_count": {
          "type": "integer"
        },
        "tagged_bookmark_count": {
          "type": "integer"
        },
        "tag_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "source_command_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "bookmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bookmark_id",
          "created_at",
          "updated_at",
          "summary",
          "tags",
          "note",
          "reference",
          "snapshot"
        ],
        "properties": {
          "bookmark_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "file",
              "pointer",
              "root",
              "stable_key"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "pointer": {
                "type": "string"
              },
              "root": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stable_key": {
                "type": "string"
              }
            }
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "hash",
              "timestamp",
              "artifact_key",
              "summary"
            ],
            "properties": {
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "hash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timestamp": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "artifact_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
