{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "generated_at",
    "run_summary",
    "options",
    "summary",
    "indicators"
  ],
  "properties": {
    "command": {
      "const": "indicators"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_summary": {
      "type": "string"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_indicators",
        "max_sources_per_indicator",
        "rule_set",
        "ti_feeds"
      ],
      "properties": {
        "max_indicators": {
          "type": "integer"
        },
        "max_sources_per_indicator": {
          "type": "integer"
        },
        "rule_set": {
          "type": "string"
        },
        "ti_feeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicator_count",
        "type_counts",
        "source_output_counts",
        "matched_rule_counts",
        "matched_indicator_count",
        "enriched_indicator_count",
        "ti_feed_count"
      ],
      "properties": {
        "indicator_count": {
          "type": "integer"
        },
        "type_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "source_output_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "matched_rule_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "matched_indicator_count": {
          "type": "integer"
        },
        "enriched_indicator_count": {
          "type": "integer"
        },
        "ti_feed_count": {
          "type": "integer"
        },
        "commercial_gap_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commercial_grade_ready": {
          "type": "boolean"
        }
      }
    },
    "ti_feed_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "format",
          "name",
          "version",
          "indicator_count",
          "local_only"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "indicator_count": {
            "type": "integer"
          },
          "local_only": {
            "type": "boolean"
          },
          "commercial_gap_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation_status": {
            "type": "string"
          },
          "ti_feed_manifest": {
            "type": "object",
            "additionalProperties": true
          },
          "ti_feed_manifest_hash": {
            "type": "string"
          }
        }
      }
    },
    "indicator_native_capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "ioc_ti_enrichment_manifest": {
      "type": "object",
      "additionalProperties": true
    },
    "ioc_ti_enrichment_manifest_hash": {
      "type": "string"
    },
    "ti_enrichment_assessment": {
      "type": "object",
      "additionalProperties": true
    },
    "core_accuracy_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "commercial_uplift_evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value",
          "count",
          "classification",
          "risk_flags",
          "sources"
        ],
        "properties": {
          "type": {
            "enum": [
              "url",
              "domain",
              "ip",
              "md5",
              "sha1",
              "sha256"
            ]
          },
          "value": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "classification": {
            "type": "string"
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "commercial_gap_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ready_for_court_report": {
            "type": "boolean"
          },
          "matched_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ioc_ti_indicator_manifest": {
            "type": "object",
            "additionalProperties": true
          },
          "ioc_ti_indicator_manifest_hash": {
            "type": "string"
          },
          "indicator_row_hash": {
            "type": "string"
          },
          "ti_enrichment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "classification": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "feed_name": {
                "type": "string"
              },
              "feed_version": {
                "type": "string"
              },
              "feed_path": {
                "type": "string"
              },
              "feed_row_hash": {
                "type": "string"
              },
              "matched_on": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "commercial_gap_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "validation_status": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
